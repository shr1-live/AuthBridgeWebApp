# Build-time values for scripts/write-env.mjs. Set the same names in Vercel's project
# environment. The frontend holds only public values: no database password and no
# secret or service-role key - the build fails if one is supplied.

# Render backend URL (local default: http://localhost:5243)
NG_APP_API_BASE_URL=http://localhost:5243

# Leave both empty for local development against the backend's LocalDev sign-in.
# Copy them from the Supabase project's API settings for a real deployment.
NG_APP_SUPABASE_URL=
NG_APP_SUPABASE_PUBLISHABLE_KEY=
